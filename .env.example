# Copy to .env and fill in what you need. Everything is optional in development.

# Photo storage. Without it, uploads are stored on the local disk (storage/).
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Redis for Action Cable in production (real-time chat).
# REDISCLOUD_URL=redis://localhost:6379/1

# Sender address of account e-mails.
# MAILER_SENDER="Tinwoof <hello@tinwoof.app>"

# Self-hosted Photon geocoder (defaults to the public photon.komoot.io).
# PHOTON_HOST=photon.example.com

# Production database password.
# TINWOOF_DATABASE_PASSWORD=
