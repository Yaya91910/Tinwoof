<div class="message" id="<%= dom_id(message) %>" data-controller="message" data-author-id="<%= message.user_id %>">
  <p class="message__bubble"><%= message.content %></p>
  <time class="message__time" datetime="<%= message.created_at.iso8601 %>"><%= l(message.created_at, format: :time) %></time>
</div>
