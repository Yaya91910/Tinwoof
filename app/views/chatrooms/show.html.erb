<% content_for :title, @interlocutor.first_name %>
<% content_for :body_class, "page-chat" %>
<% content_for :hide_tabbar, true %>

<section class="chat" data-controller="chat" data-chat-read-url-value="<%= read_chatroom_path(@chatroom) %>">
  <header class="appbar appbar--chat">
    <%= link_to chatrooms_path, class: "appbar__back icon-btn", "aria-label": "Retour aux messages" do %>
      <%= icon "chevron-left" %>
    <% end %>
    <%= link_to user_path(@interlocutor), class: "chat__peer" do %>
      <span class="presence <%= "presence--online" if @interlocutor.online? %>"><%= avatar_tag @interlocutor, size: 40 %></span>
      <span>
        <span class="chat__peer-name"><%= @interlocutor.first_name %></span>
        <span class="chat__peer-status"><%= @interlocutor.online? ? "En ligne" : "Hors ligne" %></span>
      </span>
    <% end %>
  </header>

  <%= turbo_stream_from @chatroom %>
  <div class="chat__scroller" data-chat-target="scroller">
    <p class="chat__intro">
      <%= icon "heart" %> Vous avez matché avec <%= @interlocutor.first_name %>.<br>
      Proposez un parc, une heure, et c'est parti !
    </p>
    <div id="messages" class="chat__messages" data-chat-target="messages">
      <%= render partial: "messages/message", collection: @messages %>
    </div>
  </div>

  <%= render "messages/form", chatroom: @chatroom, message: @message %>
</section>
