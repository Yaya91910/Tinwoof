<% if @comment.persisted? %>
  <%= turbo_stream.prepend "comments_list", partial: "comments/comment", locals: { comment: @comment } %>
  <%= turbo_stream.update "comments_count", @dog.comments.count.to_s %>
  <%= turbo_stream.replace "comment_form", partial: "comments/form", locals: { dog: @dog, comment: Comment.new } %>
<% else %>
  <%= turbo_stream.replace "comment_form", partial: "comments/form", locals: { dog: @dog, comment: @comment } %>
<% end %>
