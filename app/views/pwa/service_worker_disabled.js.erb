// Service worker disabled in this environment (see config.x.service_worker).
// Browsers always fetch this script from the network, so it replaces any worker installed
// earlier, clears its caches, unregisters itself and reloads the open pages.
self.addEventListener("install", () => self.skipWaiting());

self.addEventListener("activate", (event) => {
  event.waitUntil((async () => {
    const keys = await caches.keys();
    await Promise.all(keys.filter((key) => key.startsWith("tinwoof-")).map((key) => caches.delete(key)));
    await self.registration.unregister();
    const windows = await self.clients.matchAll({ type: "window" });
    windows.forEach((client) => client.navigate(client.url));
  })());
});
