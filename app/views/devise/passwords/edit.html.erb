<% content_for :title, "Nouveau mot de passe" %>
<% content_for :body_class, "page-auth" %>
<section class="auth">
  <%= render "devise/shared/auth_header", title: "Nouveau mot de passe", subtitle: "Choisissez-en un solide." %>
  <div class="auth__card">
    <%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "form" }, data: { turbo: false }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.input :reset_password_token, as: :hidden %>
      <%= f.input :password, label: "Nouveau mot de passe", required: true, autofocus: true,
                             hint: ("#{@minimum_password_length} caractères minimum" if @minimum_password_length),
                             input_html: { autocomplete: "new-password" } %>
      <%= f.input :password_confirmation, label: "Confirmation", required: true, input_html: { autocomplete: "new-password" } %>
      <%= f.button :submit, "Changer mon mot de passe" %>
    <% end %>
    <%= render "devise/shared/links" %>
  </div>
</section>
