<p>Bonjour <%= @resource.first_name %>,</p>

<% if @resource.try(:unconfirmed_email?) %>
  <p>L'adresse e-mail de votre compte Tinwoof va passer à <%= @resource.unconfirmed_email %>.</p>
<% else %>
  <p>L'adresse e-mail de votre compte Tinwoof est désormais <%= @resource.email %>.</p>
<% end %>

<p>Si ce n'est pas vous, contactez-nous au plus vite.</p>
