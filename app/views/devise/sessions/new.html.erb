<% content_for :title, "Connexion" %>
<% content_for :body_class, "page-auth" %>
<section class="auth">
  <%= render "devise/shared/auth_header", title: "Content de vous revoir", subtitle: "Les copains de balade vous attendent." %>
  <div class="auth__card">
    <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "form" }) do |f| %>
      <%= f.input :email, autofocus: true, input_html: { autocomplete: "email", inputmode: "email" } %>
      <%= f.input :password, input_html: { autocomplete: "current-password" } %>
      <%= f.input :remember_me, as: :boolean, input_html: { checked: true } if devise_mapping.rememberable? %>
      <%= f.button :submit, "Se connecter" %>
    <% end %>
    <%= render "devise/shared/links" %>
  </div>
</section>
