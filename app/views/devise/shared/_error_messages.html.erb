<% if resource.errors.any? %>
  <div class="form-alert" role="alert">
    <p><%= I18n.t("errors.messages.not_saved", count: resource.errors.count) %></p>
    <ul>
      <% resource.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
