<% content_for :title, "Modifier #{@dog.name}" %>
<%= render "shared/app_header", title: "Modifier #{@dog.name}", back: dog_path(@dog) %>
<div class="container">
  <%= render "form", dog: @dog %>

  <div class="danger-zone">
    <%= button_to dog_path(@dog), method: :delete, class: "btn btn--danger btn--block",
                  form: { data: { turbo_confirm: "Supprimer définitivement le profil de #{@dog.name} ?" } } do %>
      <%= icon "trash-can" %> Supprimer ce profil
    <% end %>
  </div>
</div>
