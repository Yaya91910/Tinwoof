<% content_for :title, @user.first_name %>
<%= render "shared/app_header", title: @user.first_name, back: :back %>

<section class="hero-profile">
  <span class="presence presence--lg <%= "presence--online" if @user.online? %>"><%= avatar_tag @user, size: 104, class: "hero-profile__avatar" %></span>
  <h1 class="hero-profile__name"><%= @user.first_name %></h1>
  <% if @user.bio.present? %><p class="hero-profile__bio"><%= @user.bio %></p><% end %>
  <%= button_to chatrooms_path(user_id: @user.id), class: "btn btn--primary" do %>
    <%= icon "paper-plane" %> Écrire à <%= @user.first_name %>
  <% end %>
</section>

<div class="container">
  <section class="section">
    <h2 class="section__title">Ses chiens</h2>
    <% if @dogs.any? %>
      <div class="dog-grid">
        <%= render partial: "dogs/card", collection: @dogs, as: :dog %>
      </div>
    <% else %>
      <p class="section__hint">Pas encore de chien inscrit.</p>
    <% end %>
  </section>
</div>
