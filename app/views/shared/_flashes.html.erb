<div class="toasts" id="toasts" aria-live="polite">
  <% flash.each do |type, message| %>
    <% next if message.blank? %>
    <div class="toast toast--<%= type == "alert" ? "alert" : "notice" %>" data-controller="toast" role="status">
      <%= icon(type == "alert" ? "circle-exclamation" : "paw", class: "toast__icon") %>
      <p class="toast__text"><%= message %></p>
      <button type="button" class="toast__close" data-action="toast#dismiss" aria-label="Fermer"><%= icon "xmark" %></button>
    </div>
  <% end %>
</div>
