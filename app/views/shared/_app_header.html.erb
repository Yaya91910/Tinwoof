<%# locals: (title:, back: nil, subtitle: nil, actions: nil) -%>
<header class="appbar">
  <% if back %>
    <%= link_to back, class: "appbar__back icon-btn", "aria-label": "Retour" do %>
      <%= icon "chevron-left" %>
    <% end %>
  <% end %>
  <div class="appbar__titles">
    <h1 class="appbar__title"><%= title %></h1>
    <% if subtitle.present? %>
      <p class="appbar__subtitle"><%= subtitle %></p>
    <% end %>
  </div>
  <% if actions.present? %>
    <div class="appbar__actions"><%= actions %></div>
  <% end %>
</header>
